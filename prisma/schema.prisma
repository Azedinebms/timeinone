generator client {
  provider   = "prisma-client"
  output     = "../lib/generated/prisma"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Country {
  id        Int      @id @default(autoincrement())
  name      String
  iso2      String   @unique @db.VarChar(2)
  iso3      String?  @unique @db.VarChar(3)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cities    City[]

  @@index([name])
  @@map("countries")
}

model Timezone {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cities    City[]

  @@index([name])
  @@map("timezones")
}

model City {
  id         Int      @id @default(autoincrement())
  name       String
  asciiName  String?
  slug       String
  latitude   Decimal? @db.Decimal(9, 6)
  longitude  Decimal? @db.Decimal(9, 6)
  population Int?
  countryId  Int
  timezoneId Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  geonameId  Int      @unique
  country    Country  @relation(fields: [countryId], references: [id])
  timezone   Timezone @relation(fields: [timezoneId], references: [id])

  @@index([name])
  @@index([asciiName])
  @@index([slug])
  @@index([slug, countryId])
  @@index([population])
  @@index([countryId])
  @@index([timezoneId])
  @@map("cities")
}
