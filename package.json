{
  "name": "timeinone",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "postinstall": "prisma generate",
    "lint": "eslint",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "audit:timezones": "tsx scripts/audit-timezones.ts",
    "audit:cities": "tsx --env-file=.env scripts/audit-city-repository.ts",
    "audit:world-clock-sitemap": "tsx --env-file=.env scripts/audit-world-clock-sitemap.ts",
    "audit:city-search": "tsx --env-file=.env scripts/audit-city-search.ts"
  },
  "dependencies": {
    "@next/third-parties": "^16.3.1",
    "@opennextjs/cloudflare": "^1.20.2",
    "@prisma/adapter-pg": "^6.19.0",
    "@prisma/client": "^6.19.0",
    "next": "16.2.11",
    "pg": "^8.22.0",
    "prisma": "^6.19.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.20.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "wrangler": "^4.120.1"
  }
}
